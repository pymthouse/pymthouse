{
  "name": "pymthouse",
  "version": "0.3.7",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "predev": "npm run db:prepare",
    "dev": "next dev -p 3001 --webpack",
    "prebuild": "[ \"$VERCEL\" = '1' ] && echo 'Skipping db:prepare on Vercel' || npm run db:prepare",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "proto:compile": "pbjs -t static-module -w es6 -o src/lib/proto-generated.js proto/lp_rpc.proto && pbts -o src/lib/proto-generated.d.ts src/lib/proto-generated.js",
    "bootstrap": "npx tsx scripts/bootstrap-admin.ts",
    "db:prepare": "npx tsx scripts/db-migrate.ts",
    "api-keys:hard-cutover": "npx tsx scripts/api-keys-hard-cutover.ts",
    "oidc:seed": "npx tsx scripts/seed-oidc.ts",
    "openmeter:bootstrap": "npx tsx scripts/openmeter-bootstrap.ts",
    "openmeter:custom-invoicing:bootstrap": "npx tsx scripts/openmeter-custom-invoicing-bootstrap.ts",
    "openmeter:custom-invoicing:e2e-bootstrap": "npx tsx scripts/openmeter-custom-invoicing-e2e-bootstrap.ts",
    "openmeter:ensure-customer": "npx tsx scripts/openmeter-ensure-customer.ts",
    "openmeter:migrate-starter-prepaid": "npx tsx scripts/openmeter-migrate-starter-prepaid.ts",
    "openmeter:fix-starter-allowance": "npx tsx scripts/openmeter-fix-starter-allowance.ts",
    "openmeter:migrate-owner-customers": "npx tsx scripts/openmeter-migrate-owner-customers.ts",
    "openmeter:migrate-end-user-customers": "npx tsx scripts/openmeter-migrate-end-user-customers.ts",
    "openmeter:dedupe-owner-subscriptions": "npx tsx scripts/openmeter-dedupe-owner-subscriptions.ts",
    "openmeter:release-legacy-subjects": "npx tsx scripts/openmeter-release-legacy-subjects.ts",
    "openmeter:repair-owner-subject-keys": "npx tsx scripts/openmeter-repair-owner-subject-keys.ts",
    "openmeter:audit-billing": "npx tsx scripts/openmeter-audit-billing-consistency.ts",
    "openmeter:inspect-charges": "npx tsx scripts/openmeter-inspect-subscription-charges.ts",
    "openmeter:fix-owner-attribution": "npx tsx scripts/openmeter-fix-owner-attribution.ts",
    "openmeter:migrate-sandbox-to-stripe": "npx tsx scripts/openmeter-migrate-sandbox-to-stripe.ts",
    "openmeter:migrate-plan-subscribers": "npx tsx scripts/openmeter-migrate-plan-subscribers.ts",
    "openmeter:backfill-collection": "npx tsx scripts/openmeter-backfill-collection-alignment.ts",
    "stripe:connect-cutover": "npx tsx scripts/stripe-connect-cutover.ts",
    "stripe:connect-cutover-audit": "npx tsx scripts/stripe-connect-cutover-audit.ts",
    "turnkey:create-webhook": "npx tsx scripts/turnkey-create-webhook.ts",
    "openmeter:railway:bootstrap": "bash scripts/openmeter-railway-bootstrap.sh",
    "railway:stack:env": "bash scripts/railway-apply-stack-env.sh",
    "railway:stack:deploy": "bash scripts/railway-deploy-stack.sh",
    "railway:preview:deploy": "bash scripts/railway-deploy-stack.sh preview",
    "railway:preview:migrate": "bash scripts/railway-migrate-preview-clearinghouse.sh",
    "vercel:preview:env": "bash scripts/apply-pymthouse-preview-vercel-env.sh",
    "railway:signer:env": "bash scripts/railway-apply-signer-env.sh",
    "railway:signer:deploy": "bash scripts/railway-apply-signer-env.sh production --deploy",
    "validate:env": "node scripts/validate-env.js",
    "openapi:generate": "npx tsx scripts/generate-openapi-routes.ts",
    "check:openapi": "npm run openapi:generate && npx tsx scripts/check-openapi.ts",
    "e2e:merchant-payments": "npx tsx scripts/e2e/merchant-payments.ts",
    "test": "node --import ./src/test-env.ts --import tsx --test --test-force-exit \"src/**/*.test.ts\" \"src/**/*.test.mjs\"",
    "test:coverage": "mkdir -p coverage && c8 --reporter=text --reporter=lcov --report-dir=coverage --include='src/**' --exclude='**/*.test.ts' --exclude='**/*.test.mjs' node --import ./src/test-env.ts --import tsx --test --test-force-exit \"src/**/*.test.ts\" \"src/**/*.test.mjs\""
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@braintree/sanitize-url": "^7.1.2",
"@modelcontextprotocol/sdk": "^1.30.0",
    "@openmeter/sdk": "^1.0.0-beta.232",
    "@pymthouse/builder-sdk": "^0.6.5",
    "@pymthouse/clearinghouse-identity-webhook": "0.5.0-rc.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@turnkey/crypto": "^2.11.3",
    "@turnkey/react-wallet-kit": "^2.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.9",
    "next": "16.3.1",
    "next-auth": "^4.24.15",
    "oidc-provider": "^9.11.3",
    "postgres": "^3.4.9",
    "protobufjs": "^8.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "esbuild": "^0.28.1",
    "next-auth": {
      "uuid": "^11.1.1"
    },
    "minimatch": "^10.2.6",
    "js-yaml": "4.3.1",
    "nanoid": "5.1.16",
    "postcss": "$postcss",
    "undici": "^7.29.0",
    "ws": "8.21.1",
    "@hono/node-server": "2.0.11",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@redocly/cli": "^2.46.1",
    "@turnkey/sdk-server": "^8.2.0",
    "@types/node": "^26.2.0",
    "@types/oidc-provider": "^9.11.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^11.0.0",
    "c8": "^12.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
