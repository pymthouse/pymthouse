# pymthouse environment configuration

# ---------- App ----------
# Public client_id (`app_…`) for the platform default Explorer app.
# Optional — bootstrap creates one flagged is_platform_default when unset.
# PYMTHOUSE_DEFAULT_APP_CLIENT_ID=app_0123456789abcdef01234567
# Public Mintlify docs base URL (defaults to https://docs.pymthouse.com).
# NEXT_PUBLIC_DOCS_URL=https://docs.pymthouse.com
# Public-facing URL of the app. NextAuth uses this for absolute redirects
# (e.g. https://pymthouse.com). In production this must be your actual domain
# with HTTPS — NOT localhost — or OAuth redirects and OIDC device verification
# URLs will point to http and fail. If you set http://pymthouse.com, the app
# will auto-upgrade to https for non-localhost hosts.
# GitHub → Turnkey wallet login callback (when GITHUB_* is set):
#   {NEXTAUTH_URL}/api/auth/github/callback
NEXTAUTH_URL=http://localhost:3001
# When running behind a reverse proxy (e.g. Apache → localhost:3001), set
# NEXTAUTH_URL_INTERNAL so server-side NextAuth calls bypass the proxy and
# go directly to the local Next.js process. Leave unset for local dev.
# NEXTAUTH_URL_INTERNAL=http://localhost:3001
# Generate once and keep stable. Example:
#   openssl rand -base64 32
# If .env.local also sets NEXTAUTH_SECRET, it overrides this value.
NEXTAUTH_SECRET=replace-with-random-base64-secret

# Server-side pepper used by PBKDF2-SHA256 to hash bearer tokens, API keys,
# and OIDC refresh tokens before storage. Must be >=32 chars and kept stable
# for the lifetime of the deployment — changing this value invalidates every
# existing token_hash / key_hash row and requires re-issuing all credentials.
# Generate once:
#   openssl rand -base64 48
AUTH_TOKEN_PEPPER=replace-with-random-base64-pepper

# ---------- OAuth Providers ----------
# Legacy NextAuth Google admin OAuth (unused when admin uses bearer token).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub → Turnkey wallet login (BYO OIDC). Client ID is public; secret is server-only.
# Authorization callback URL in the GitHub OAuth App must be:
#   {NEXTAUTH_URL}/api/auth/github/callback
# Also requires Turnkey Wallet Kit + TURNKEY_API_PUBLIC_KEY / TURNKEY_API_PRIVATE_KEY.
# Issuer discovery (public URL required for Turnkey enclaves):
#   {NEXTAUTH_URL}/api/v1/turnkey-github-oidc/.well-known/openid-configuration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional override if NEXTAUTH_URL is not internet-reachable (e.g. tunnel / prod issuer).
# TURNKEY_GITHUB_OIDC_ISSUER=https://pymthouse.com/api/v1/turnkey-github-oidc

# ---------- Database (PostgreSQL; Neon or any libpq URL) ----------
# Required. Migrations run on `npm run dev` / `npm run build` via db:prepare.
# Example (Neon): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------- go-livepeer remote signer (local = full signer-dmz) ----------
# Clearinghouse stack (signer + kafka + collector): recommended for local dev
# Start the full stack so Kafka events reach the OpenMeter collector:
#   docker compose -f docker-compose.clearinghouse.railway.yml --env-file .env.local up -d --build
# go-livepeer binary source for signer-dmz-local build (published CI image by default):
# LIVEPEER_IMAGE=livepeer/go-livepeer:sha-9d92ee43300fead9cbcece0867ba04814e3ed218
# Or build DMZ only: ./scripts/build-local-signer.sh
# Standalone signer (no kafka): docker compose up -d signer-dmz
# The local compose image is signer-dmz: Apache validates RS256 bearer tokens
# (iss/aud/scope) using the OIDC public key from JWKS — same model as production.
# Only PymtHouse-issued short-lived tokens reach go-livepeer; /status and /healthz
# stay open for health. Match SIGNER_DMZ_HOST_PORT in docker-compose (default 8080).
# Host publish binds to 127.0.0.1 by default (SIGNER_DMZ_BIND_HOST). Use
# 127.0.0.1 in URLs below when PymtHouse runs on the same host; remote callers
# need your server's hostname/IP and valid DMZ JWTs (scope=sign:job / admin).
# Public TLS: host Apache → 127.0.0.1:8080 (see deploy/host-apache/). Do not bind 0.0.0.0 in production.
# SIGNER_DMZ_BIND_HOST=127.0.0.1
# SIGNER_DMZ_HOST_PORT=8080
SIGNER_INTERNAL_URL=http://127.0.0.1:8080
# Apache CLI admin endpoint (admin scope): path-mounted on the same host/port as
# the signer HTTP API (SIGNER_CLI_URL default path /__signer_cli). Restrict with
# path- or host-level firewall and monitoring—not a separate listener port.
SIGNER_CLI_URL=http://127.0.0.1:8080/__signer_cli
# Optional: JWKS URL for signer-dmz (defaults: same issuer as NEXTAUTH_URL, host
# rewritten to host.docker.internal inside the container). jwks_to_pem allows
# https anywhere, or http only for localhost / 127.0.0.1 / host.docker.internal.
# If JWKS is HTTPS, certificates must verify. For local/dev self-signed JWKS,
# use http://localhost or http://host.docker.internal instead.
# (signer-dmz `jwks_to_pem.py` only; not for production).
# SIGNER_DMZ_JWKS_URL=http://host.docker.internal:3001/api/v1/oidc/jwks
#
# Admin “restart signer” passes OIDC_ISSUER = getIssuer() and JWKS for that issuer
# so Apache validates the same JWTs this app mints (local oidc:seed keys).
SIGNER_NETWORK=arbitrum-one-mainnet
# Ethereum RPC endpoint for the signer
ETH_RPC_URL=https://arb1.arbitrum.io/rpc
# Remote signer auth webhook (go-livepeer -> pymthouse webhook).
REMOTE_SIGNER_WEBHOOK_URL=http://host.docker.internal:3001/webhooks/remote-signer
# Shared secret for go-livepeer -remoteSignerWebhookHeaders (X-Api-Key:... in entrypoint.sh).
WEBHOOK_SECRET=
# Kafka monitor event bus for go-livepeer create_signed_ticket events.
KAFKA_BROKERS=kafka.railway.internal:9092
KAFKA_GATEWAY_TOPIC=livepeer-gateway-events
# Collector ETH/USD oracle (startup warm + periodic refresh).
PRICE_ORACLE_URL=https://api.coinbase.com/v2/prices/ETH-USD/spot
PRICE_ORACLE_REFRESH=5m
# App-side oracle fallback (eth-usd-oracle.ts), not used by the collector.
ETH_USD_PRICE=3500
# Identity webhook verifier (@pymthouse/clearinghouse-identity-webhook).
# Required for POST /webhooks/remote-signer. Defaults are applied in-app from
# NEXTAUTH_URL — only override when you need a non-standard mapping.
# IDENTITY_AUTH_MODE=oidc
# IDENTITY_ISSUER defaults to NEXTAUTH_URL + /api/v1/oidc (OIDC_ISSUER is a legacy alias).
# OIDC_AUDIENCE defaults to the issuer; claim/scope defaults:
#   OIDC_CLIENT_CLAIM=client_id
#   OIDC_SUBJECT_CLAIM=external_user_id
#   OIDC_SUBJECT_TYPE=external_user_id
#   OIDC_REQUIRED_SCOPES=sign:job
# OIDC_TOKEN_EXCHANGE_BASE_URL defaults to NEXTAUTH_URL (composite app_*_* keys).
# Optional JWKS override / M2M Basic for the exchange call:
# OIDC_JWKS_URI=http://localhost:3001/api/v1/oidc/jwks
# OIDC_EXCHANGE_M2M_CLIENT_ID=
# OIDC_EXCHANGE_M2M_CLIENT_SECRET=
# Remote-signer balance gate tuning:
# SIGNER_BALANCE_CACHE_TTL_SECONDS (default 20, 0 disables) — short-lived
#   in-memory cache + request coalescing for spendable-balance lookups, so
#   concurrent webhook calls for the same identity share one OpenMeter/Neon
#   fan-out.
# SIGNER_BALANCE_REAUTH_TTL_SECONDS (default 60) — caps how long go-livepeer
#   caches a successful authorization before re-checking balance. Raising it
#   (e.g. 120–300) cuts webhook traffic and first-request latency pressure, but
#   widens the window in which an exhausted balance can keep spending; the
#   worst-case overspend is roughly (spend rate x TTL).
# SIGNER_BALANCE_CACHE_TTL_SECONDS=20
# SIGNER_BALANCE_REAUTH_TTL_SECONDS=60
# Hot-path ensure/resolve caches (all bounded, singleflight, 0 disables).
# These keep idempotent provisioning lookups out of warm webhook/mint calls:
# APP_USER_PROVISION_CACHE_TTL_SECONDS=300     # skip full billing provisioning fan-out
# BILLING_IDENTITY_CACHE_TTL_SECONDS=300       # Neon app→owner identity resolution
# OPENMETER_CUSTOMER_ENSURE_CACHE_TTL_SECONDS=300  # Konnect customer ensure round-trips
# STARTER_PLAN_SYNC_CACHE_TTL_SECONDS=300      # per-app Starter plan verify/sync
# OWNER_STARTER_PLAN_CACHE_TTL_SECONDS=600     # platform Owner Starter plan ref
# OWNER_PAID_PLAN_CACHE_TTL_SECONDS=600        # platform Owner Paid plan ref
# OPENMETER_PLAN_KEY_CACHE_TTL_SECONDS=3600    # OpenMeter plan id → key lookups
# ---------- Livepeer MCP (hosted /api/v1/mcp) ----------
# Auth: caller Bearer API key/JWT or Basic M2M. See docs/livepeer-mcp.md
# DISCOVERY_SERVICE_URL=https://discovery-service-production-8955.up.railway.app

# ---------- OpenMeter (usage metering + trial credits) ----------
# Local: docker compose -f docker-compose.openmeter.yml up -d && npm run openmeter:bootstrap
# Hosted Konnect/OpenMeter (production): OPENMETER_URL=https://{region}.api.konghq.com/v3/openmeter
# Collector ingest (Konnect): defaults to ${OPENMETER_URL}/events
# OPENMETER_INGEST_URL=https://us.api.konghq.com/v3/openmeter/events
# Self-hosted Railway OpenMeter can still be used for local/on-prem testing.
OPENMETER_POSTGRES_SECRET=postgres
OPENMETER_CLICKHOUSE_SECRET=default
OPENMETER_URL=http://127.0.0.1:48888


# Route mode:
# - auto (default): infer from OPENMETER_URL / OPENMETER_API_KEY (app admin API key)
# - self_hosted: use OpenMeter SDK /api/v1 routes
# - hosted: use hosted Konnect-style routes (no /api/v1 prefix)
OPENMETER_ROUTE_MODE=auto
# Optional for local docker; required for OpenMeter Cloud / auth-enabled installs.
OPENMETER_API_KEY=
# Optional collector-only ingest key. Falls back to OPENMETER_API_KEY when unset.
OPENMETER_INGEST_API_KEY=
# Builder app activation gate (docs/activation-gate.md). Default off — resolve + expose only.
# off | log | enforce_revenue | enforce
# ACTIVATION_GATE_MODE=off
OPENMETER_TRIAL_FEATURE_KEY=network_spend

# Cost-rail defaults a new app inherits. These protect PymtHouse rather than
# configure the Builder, so they are admin-only on the API and read-only in the
# app's Payments tab. Setting them here changes platform policy without a
# migration. Unset = 10_000 end users, 0 bps fee.
# Reintroduce a tighter (or higher) cap later via this env or per-app admin override.
PYMTHOUSE_DEFAULT_END_USER_CAP=10000
# PYMTHOUSE_DEFAULT_APPLICATION_FEE_BPS=0
# Bootstrap included usage (USD micros) for:
#   - per-app M2M Starter seed (always), and
#   - Owner Starter platform default when no admin DB row exists yet
#     (admin UI: /admin/billing → platform_billing_settings).
# 5000000 = $5
OPENMETER_DEFAULT_STARTER_INCLUDED_USD_MICROS=5000000

# ---------- Plane A: OpenMeter Stripe app (platform cost rail) ----------
# Developers pay PymtHouse for network usage via Kong/OM billing profiles.
# ISO 3166-1 alpha-2 country on per-app billing profile supplier (default US)
# OPENMETER_BILLING_SUPPLIER_COUNTRY=US
# Konnect only: pin a specific org Stripe app when multiple are installed
# OPENMETER_STRIPE_APP_ID=01G65Z755AFWAKHE12NY0CQ9FH
# Platform Stripe secret key for the SAME account installed in Konnect/OpenMeter
# (used to mint cus_… for OM customer app_data).
# STRIPE_SECRET_KEY=sk_live_…
# Optional override for the shared owners Stripe billing profile id
# OPENMETER_OWNERS_BILLING_PROFILE_ID=
# Optional override for the fixed Owner Paid catalog plan key (default pymthouse_owner_paid)
# OPENMETER_OWNER_PAID_PLAN_KEY=pymthouse_owner_paid

# ---------- Plane B: Merchant Stripe Connect (revenue rail) ----------
# Builders collect from end users on Connected Accounts; PymtHouse takes application_fee_bps.
# Connect webhook signing secret (Dashboard → Webhooks → connected-account events → /webhooks/stripe)
# Prefer STRIPE_CONNECT_WEBHOOK_SECRET when the Connect endpoint has its own secret.
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_…
# After hard cutover, force Connect-only checkout globally (optional; prefer per-app connectPaymentsOnly)
# STRIPE_CONNECT_PAYMENTS_ONLY=0

# ---------- Merchant Custom Invoicing (OpenMeter → Connect collection) ----------
# Bootstrap: npm run openmeter:custom-invoicing:bootstrap
# Collection is owned by pymthouse/settlement (Kafka producer + Go worker), not
# an in-repo Railway worker. Point Konnect invoice notifications and Stripe
# payment webhooks at the settlement producer.
# OPENMETER_CUSTOM_INVOICING_APP_ID=
# OPENMETER_MERCHANT_BILLING_PROFILE_ID=
# Bootstrap requires the settlement producer OpenMeter ingress URL:
# SETTLEMENT_OPENMETER_WEBHOOK_URL=https://settlement.example.com/webhooks/openmeter

# Required for usage totals, allowance balance, and signed-ticket metering
# OPENMETER_URL=http://127.0.0.1:48888

# Billing API v2 (see src/lib/billing/feature-flags.ts)
BILLING_PLANS_API_V2=true
BILLING_STABLE_FEATURE_KEYS=true

# Headless agent network registration (GET/POST /api/v1/network/register*).
# Default OFF. Set to 1 to allow agents to mint Explorer-style keys via Ed25519 challenge.
# NETWORK_AGENT_REGISTER_ENABLED=1

# ---------- BPP ② subscriptionRef ----------
# NaaP reads usage by PULLING from pymthouse (M2M client / builder-sdk usage
# helpers backed by OpenMeter). There is no outbound usage push from pymthouse.
# HMAC key for the OPAQUE BPP ② `subscriptionRef` (one-way; raw OpenMeter id is
# unrecoverable from the ref). Min 32 chars. If unset, falls back to
# AUTH_TOKEN_PEPPER with a one-time warning. Generate: openssl rand -base64 48
# SUBSCRIPTION_REF_SECRET=
# Authoritative metering path is Kafka -> collector -> OpenMeter.
# Set to true only during dual-write validation windows.
# ---------- Turnkey Wallet Kit (embedded wallets) ----------
# From Turnkey dashboard → Wallet Kit / Auth Proxy
NEXT_PUBLIC_ORGANIZATION_ID=
NEXT_PUBLIC_AUTH_PROXY_CONFIG_ID=
# OAuth return URL for Google/Discord/etc (must match Turnkey Auth Proxy + provider consoles).
# Local: http://localhost:3001/auth/callback
# Prod:  https://pymthouse.com/auth/callback
# NEXT_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:3001/auth/callback
# Optional Terms / Privacy links shown under the auth panel (kit hardcodes Turnkey URLs).
# NEXT_PUBLIC_TERMS_URL=https://www.turnkey.com/legal/terms
# NEXT_PUBLIC_PRIVACY_URL=https://www.turnkey.com/legal/privacy
# Optional: comma-separated organization UUIDs allowed for session JWTs (defense in depth)
# TURNKEY_ALLOWED_ORGANIZATION_IDS=
#
# Optional Auth Proxy social login overrides (usually set in Turnkey dashboard instead).
# Enable Google/Apple/X/Discord under Embedded Wallets → Configuration → Social logins.
# Redirect URL must match the OAuth app (e.g. http://localhost:3001 or https://your.domain).
# GitHub is handled in-app via BYO OIDC (GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET above),
# not Auth Proxy — same Turnkey wallet + NextAuth bridge as other social methods.
# NEXT_PUBLIC_TURNKEY_OAUTH_REDIRECT_URI=http://localhost:3001
# NEXT_PUBLIC_TURNKEY_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_TURNKEY_APPLE_CLIENT_ID=
# NEXT_PUBLIC_TURNKEY_DISCORD_CLIENT_ID=
# NEXT_PUBLIC_TURNKEY_X_CLIENT_ID=

# ---------- Turnkey balance → TicketBroker auto-funding ----------
# Turnkey balance webhook (balances:finalized) credits signer wallet deposits
# into TicketBroker via the protected /__signer_cli/fundDepositAndReserve route.
# Full guide: docs/turnkey-ticket-funding.md
# Register the webhook with: npm run turnkey:create-webhook
# TURNKEY_FUNDING_CAIP2=eip155:42161
# Amount held back from each deposit for gas (wei). Default: 100000000000000 (0.0001 ETH)
# TICKET_FUNDING_GAS_BUFFER_WEI=100000000000000
# Minimum credited to TicketBroker after buffer (wei). Default: 1000000000000000 (0.001 ETH)
# TICKET_FUNDING_MIN_WEI=1000000000000000
# Target TicketBroker reserve balance (wei). Incoming fundWei fills reserve until
# this amount; once reserve >= RESERVE_AMOUNT, 100% goes to deposit. Default: 0.25 ETH.
# RESERVE_AMOUNT=250000000000000000
# Set RESERVE_AMOUNT=0 for all-to-deposit behavior.
# Minimum incoming deposit (defaults): buffer + min + 1 wei ≈ 0.0011 ETH; send ≥ 0.002 ETH in practice.

# ---------- OIDC ----------
# `npm run oidc:seed` now ensures only the signing key exists.
# Register confidential clients through the app dashboard or API,
# then rotate each client secret from `/api/v1/apps/{clientId}/credentials`.
#
# JWKS URL stored on developer_apps for RFC 8693 token exchange (public host).
# Defaults to https://pymthouse.com/api/v1/oidc/jwks — set for self-hosted only.
# PLATFORM_JWKS_URL=https://your-domain.com/api/v1/oidc/jwks
